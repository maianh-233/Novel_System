# Sao chép thành .env rồi sửa giá trị.
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173

# Khớp với docker-compose.yml ở thư mục gốc
DATABASE_URL=postgresql://novel:novel@localhost:55432/novel_game?schema=public

# Tài khoản giáo viên duy nhất — được tạo bởi `npm run db:seed`
ADMIN_USERNAME=teacher
ADMIN_PASSWORD=change-me-please

# Khoá ký phiên đăng nhập — tối thiểu 32 ký tự, mỗi môi trường một khoá riêng.
# Tạo: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_SESSION_HOURS=12
# Học sinh đăng nhập một lần dùng được bao lâu (giờ) — 168 = 7 ngày
STUDENT_SESSION_HOURS=168

# Thư mục lưu ảnh/âm thanh giáo viên tải lên
UPLOAD_DIR=uploads
