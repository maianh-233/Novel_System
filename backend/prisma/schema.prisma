// Mô hình dữ liệu Novel Game — xem docs/PLAN.md mục 3.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ───────────── Quản trị ─────────────

model Admin {
  id                String              @id @default(cuid())
  username          String              @unique
  passwordHash      String
  /// Phiên đăng nhập (JWT) phát hành trước thời điểm này đều bị từ chối.
  passwordChangedAt DateTime            @default(now())
  revokedTokens     RevokedAdminToken[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
}

/// Phiên đăng nhập giáo viên đã đăng xuất (theo `jti` trong JWT). Chỉ cần giữ tới khi
/// token tự hết hạn; bản ghi quá hạn được dọn mỗi lần đăng xuất.
model RevokedAdminToken {
  jti       String   @id
  adminId   String
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

// ───────────── Nội dung ─────────────

model Category {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  icon      String?
  isHidden  Boolean      @default(false)
  order     Int          @default(0)
  words     Vocabulary[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

enum VocabularyStatus {
  ACTIVE
  INACTIVE
}

model Vocabulary {
  id         String             @id @default(cuid())
  word       String
  meaning    String
  ipa        String?
  imageUrl   String?
  audioUrl   String?
  example    String?
  level      Int                @default(1) // 1–3
  status     VocabularyStatus   @default(ACTIVE)
  category   Category           @relation(fields: [categoryId], references: [id])
  categoryId String
  lessons    LessonVocabulary[]
  answers    PlayAnswer[]
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@unique([word, categoryId])
  @@index([categoryId, status])
}

/// Cấp học: tiểu học (khối 1–5) hoặc cấp 2 (khối 6–9) — xem docs/PLAN-CAP2.md.
enum Stage {
  primary
  secondary
}

model Lesson {
  id          String             @id @default(cuid())
  title       String
  description String?
  level       Int                @default(1)
  isPublished Boolean            @default(false)
  /// null = dùng cho cả hai cấp học.
  stage       Stage?             @default(primary)
  /// null = mọi khối của cấp học.
  grade       Int?
  words       LessonVocabulary[]
  questions   LessonQuestion[]
  games       GameLesson[]
  sessions    PlaySession[]
  assignments Assignment[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model LessonVocabulary {
  lesson       Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId     String
  vocabulary   Vocabulary @relation(fields: [vocabularyId], references: [id])
  vocabularyId String
  order        Int        @default(0)

  @@id([lessonId, vocabularyId])
}

// ───────────── Ngân hàng câu hỏi (C1) ─────────────

/// Dạng câu hỏi — trùng QUESTION_TYPES ở @novel/shared.
enum QuestionType {
  mcq
  pronunciation
  stress
  error
  true_false
  verb_form
  word_form
  fill
  rewrite
  reorder
}

/// Đoạn văn cho đọc hiểu / điền từ; nhiều câu hỏi dùng chung một đoạn.
model Passage {
  id        String     @id @default(cuid())
  title     String
  text      String
  audioUrl  String?
  questions Question[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

/// "Xoá" câu đã dùng = ngừng dùng (giống Vocabulary) để không hỏng lịch sử bài làm.
model Question {
  id          String           @id @default(cuid())
  type        QuestionType
  prompt      String
  hint        String?
  /// Lựa chọn (dạng chọn) hoặc cụm từ (sắp xếp); [] với dạng gõ.
  options     Json             @default("[]")
  /// Dạng chọn: [vị trí đáp án]; dạng gõ / sắp xếp: các đáp án chấp nhận.
  answers     Json             @default("[]")
  explanation String?
  grammarTag  String?
  level       Int              @default(1)
  /// null = dùng cho cả hai cấp học.
  stage       Stage?           @default(secondary)
  passage     Passage?         @relation(fields: [passageId], references: [id])
  passageId   String?
  status      VocabularyStatus @default(ACTIVE)
  lessons     LessonQuestion[]
  examItems   ExamItem[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([type, status])
  @@index([grammarTag])
  @@index([passageId])
}

model LessonQuestion {
  lesson     Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId   String
  question   Question @relation(fields: [questionId], references: [id])
  questionId String
  order      Int      @default(0)

  @@id([lessonId, questionId])
  @@index([questionId])
}

// ───────────── Luyện đề và thi (C2) ─────────────

enum ExamMode {
  practice
  exam
}

/// Khi nào em được xem đáp án + giải thích (điểm thì xem ngay khi nộp).
enum ResultVisibility {
  after_submit
  after_close
}

model Exam {
  id          String           @id @default(cuid())
  title       String
  description String?
  mode        ExamMode         @default(exam)
  durationMin Int              @default(40)
  opensAt     DateTime?
  closesAt    DateTime?
  /// 0 = không giới hạn.
  maxAttempts Int              @default(1)
  shuffle     Boolean          @default(true)
  showResult  ResultVisibility @default(after_close)
  /// null = cả hai cấp học.
  stage       Stage?           @default(secondary)
  /// null = mọi khối.
  grade       Int?
  isPublished Boolean          @default(false)
  sections    ExamSection[]
  attempts    ExamAttempt[]
  assignments Assignment[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model ExamSection {
  id     String     @id @default(cuid())
  exam   Exam       @relation(fields: [examId], references: [id], onDelete: Cascade)
  examId String
  title  String
  order  Int        @default(0)
  items  ExamItem[]

  @@index([examId])
}

model ExamItem {
  id         String       @id @default(cuid())
  section    ExamSection  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  sectionId  String
  question   Question     @relation(fields: [questionId], references: [id])
  questionId String
  points     Float        @default(1)
  order      Int          @default(0)
  answers    ExamAnswer[]

  @@index([sectionId])
  @@index([questionId])
}

model ExamAttempt {
  id            String       @id @default(cuid())
  exam          Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  examId        String
  student       Student      @relation(fields: [studentId], references: [id])
  studentId     String
  startedAt     DateTime     @default(now())
  /// Máy chủ giữ hạn nộp; cho thêm 30 giây vì mạng chậm.
  deadlineAt    DateTime
  submittedAt   DateTime?
  /// true = hết giờ, máy tự nộp những câu đã lưu.
  autoSubmitted Boolean      @default(false)
  /// Thang 10.
  score         Float?
  earned        Float?
  maxPoints     Float        @default(0)
  correctCount  Int          @default(0)
  /// Thứ tự câu / lựa chọn đã trộn của lượt này (AttemptOrder ở @novel/shared).
  order         Json
  answers       ExamAnswer[]

  @@index([examId, studentId])
  @@index([studentId, startedAt])
}

/// Lưu ngay mỗi khi em chọn / gõ (tự lưu). `response` theo thứ tự em thấy.
model ExamAnswer {
  attempt   ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  attemptId String
  item      ExamItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId    String
  response  Json?
  flagged   Boolean     @default(false)
  correct   Boolean?
  points    Float?
  updatedAt DateTime    @updatedAt

  @@id([attemptId, itemId])
}

// ───────────── Bài tập về nhà (C3) ─────────────

enum AssignmentKind {
  lesson_game
  exam
}

/// Bài tập về nhà. Tiến độ không lưu riêng: tính từ PlaySession / ExamAttempt có sẵn.
model Assignment {
  id        String            @id @default(cuid())
  title     String
  note      String?
  kind      AssignmentKind
  /// Bài game: Unit + game; chỉ tính lượt chơi từ lúc giao bài (`createdAt`).
  lesson    Lesson?           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId  String?
  gameSlug  String?
  minStars  Int               @default(1)
  /// Bài đề: mọi lượt đã nộp của đề đều tính.
  exam      Exam?             @relation(fields: [examId], references: [id], onDelete: Cascade)
  examId    String?
  /// true = mọi học sinh (đúng cấp học của nội dung); false = các lớp trong `classes`.
  forAll    Boolean           @default(false)
  classes   AssignmentClass[]
  dueAt     DateTime
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([dueAt])
}

model AssignmentClass {
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  assignmentId String
  classGroup   ClassGroup @relation(fields: [classId], references: [id], onDelete: Cascade)
  classId      String

  @@id([assignmentId, classId])
  @@index([classId])
}

// ───────────── Trò chơi ─────────────

model Game {
  id        String        @id @default(cuid())
  slug      String        @unique // trùng với GameManifest.slug ở frontend
  isEnabled Boolean       @default(true)
  config    Json          @default("{}")
  lessons   GameLesson[]
  sessions  PlaySession[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model GameLesson {
  game     Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  gameId   String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId String

  @@id([gameId, lessonId])
}

// ───────────── Học sinh ─────────────
// Chỉ lưu tên hiển thị + username: không email, ngày sinh, SĐT.

/// Lớp học (vd: 7A). Cấp học suy ra từ khối. Cuối năm lưu trữ lớp cũ, không xoá.
model ClassGroup {
  id          String            @id @default(cuid())
  name        String
  grade       Int // 1–9
  stage       Stage
  isArchived  Boolean           @default(false)
  students    Student[]
  assignments AssignmentClass[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([isArchived])
}

model Student {
  id                String         @id @default(cuid())
  displayName       String
  username          String         @unique
  passwordHash      String
  avatar            String?
  /// null = chưa xếp lớp (coi như tiểu học).
  classGroup        ClassGroup?    @relation(fields: [classId], references: [id])
  classId           String?
  totalStars        Int            @default(0)
  totalPoints       Int            @default(0)
  isActive          Boolean        @default(true)
  /// Phiên đăng nhập phát hành trước thời điểm này bị từ chối (đặt lại mật khẩu, khoá tài khoản).
  passwordChangedAt DateTime       @default(now())
  sessions          PlaySession[]
  examAttempts      ExamAttempt[]
  badges            StudentBadge[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([classId])
}

model PlaySession {
  id           String       @id @default(cuid())
  student      Student      @relation(fields: [studentId], references: [id])
  studentId    String
  game         Game         @relation(fields: [gameId], references: [id])
  gameId       String
  lesson       Lesson       @relation(fields: [lessonId], references: [id])
  lessonId     String
  level        Int          @default(1)
  /// Cấp học của em lúc chơi — quyết định bộ độ khó game đã dùng.
  stage        Stage        @default(primary)
  /// Từ được phát cho lượt này — kết quả gửi lên chỉ được chứa các từ này.
  wordIds      String[]     @default([])
  /// Giới hạn thời gian của game lúc bắt đầu lượt (giây, 0 = không giới hạn) — dùng để chấm sao.
  timeLimitSec Int          @default(0)
  score        Int          @default(0)
  stars        Int          @default(0)
  correctCount Int          @default(0)
  wrongCount   Int          @default(0)
  durationMs   Int?
  startedAt    DateTime     @default(now())
  finishedAt   DateTime? // null = lượt chơi chưa kết thúc
  answers      PlayAnswer[]

  @@index([studentId, startedAt])
  @@index([gameId, startedAt])
}

model PlayAnswer {
  id           String      @id @default(cuid())
  session      PlaySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId    String
  vocabulary   Vocabulary  @relation(fields: [vocabularyId], references: [id])
  vocabularyId String
  correct      Boolean
  attempts     Int         @default(1)

  @@index([vocabularyId])
}

// ───────────── Thành tích ─────────────

model Badge {
  id       String         @id @default(cuid())
  code     String         @unique
  name     String
  icon     String?
  rule     Json // vd: { "type": "sessions", "count": 10 }
  students StudentBadge[]
}

model StudentBadge {
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  badgeId   String
  earnedAt  DateTime @default(now())

  @@id([studentId, badgeId])
}
